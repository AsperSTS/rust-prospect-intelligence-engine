# Ejemplo de archivo de credenciales para Prospect Intelligence.
# Copiar como `credentials.env` dentro del directorio de datos de la aplicación
# (por defecto `~/Library/Application Support/Prospect Intelligence/credentials.env`
# o `$PROSPECTOS_HOME/credentials.env`) con permisos 0600.

# Token de consulta para la API del DENUE (INEGI)
DENUE_TOKEN=

# Token para indicadores del INEGI (si se omite, reutiliza DENUE_TOKEN)
INEGI_TOKEN=

# Token de consulta para la API SIE de Banxico (tipo de cambio)
BANXICO_TOKEN=
